PORT=3000
AUTH_TOKEN=change-me-to-a-long-random-string
# Must point outside any redeployed/git-cloned directory, otherwise the WhatsApp
# session is wiped on every deploy. Leave unset for local dev (uses ./auth).
AUTH_DIR=/home/USERNAME/mineev-bot-data/auth

# Telegram job parser (optional; install Python dependencies on the host first).
TELEGRAM_PARSER_ENABLED=false
TELEGRAM_PARSER_PYTHON=/home/USERNAME/mineev-bot-data/venv/bin/python
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DATABASE_PATH=/home/USERNAME/mineev-bot-data/telegram/app.db
POLL_INTERVAL_SECONDS=900
# Set true only when Playwright Chromium is installed on the host.
ENABLE_AMS=false
