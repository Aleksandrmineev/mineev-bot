# Telegram credentials only — kept separate from .env so they're easy to
# find and edit without scrolling through unrelated settings.
# Copy to telegram.env and fill in your own values. Never commit the real
# telegram.env file.

# Get this from @BotFather on Telegram after creating a bot with /newbot
TELEGRAM_BOT_TOKEN=

# Your personal chat id. Leave empty on first run: start the bot and send
# /start, it will reply with your chat id. Then put it here and restart.
# Once set, the bot only accepts commands from this chat.
TELEGRAM_CHAT_ID=
