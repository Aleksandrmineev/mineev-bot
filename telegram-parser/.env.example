# Copy to .env and fill in your own values. Never commit the real .env file.
#
# Telegram credentials (TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID) are NOT here —
# see telegram.env.example, copy it to telegram.env and fill those in there.

# How often to check saved searches, in seconds. Minimum enforced: 900 (15 min).
POLL_INTERVAL_SECONDS=900

# SQLite database file path.
DATABASE_PATH=data/app.db

# User-Agent sent with requests to karriere.at. Keep it honest and non-spoofed.
USER_AGENT=KarriereTelegramParser/0.1 (+personal job alert bot; respects robots and rate limits)

# HTTP request timeout, in seconds.
REQUEST_TIMEOUT_SECONDS=15

# Delay between consecutive requests within one check cycle, in seconds.
REQUEST_DELAY_SECONDS=3

# Max retries for transient errors (timeouts, 5xx). 429/403 are never retried.
MAX_RETRIES=3
RETRY_BASE_DELAY_SECONDS=2

# Path to the local filter configuration (see config/filters.example.yaml).
FILTERS_CONFIG_PATH=config/filters.example.yaml

# Delete dedup records older than this many days.
RECORD_RETENTION_DAYS=90

# AMS public UI parser. Disabled by default; requires Playwright Chromium.
ENABLE_AMS=false
AMS_URL=https://jobs.ams.at/public/emps/
BROWSER_HEADLESS=true

# Protect the remote web dashboard with HTTP Basic Auth (username: admin).
DASHBOARD_TOKEN=
